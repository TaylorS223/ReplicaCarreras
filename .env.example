# ─── WordPress API ────────────────────────────────────────────────────────────
# URL completa del endpoint REST de WordPress (server-only, sin prefijo NEXT_PUBLIC_).
# Solo se usa en Server Components y API routes — nunca llega al bundle del cliente.
WORDPRESS_API_BASE_URL=http://your-wordpress-domain/wp-json/wp/v2

# ─── Imágenes de WordPress (next/image remotePatterns) ────────────────────────
# Hostname del servidor de medios de WordPress (sin protocolo, sin path).
WORDPRESS_MEDIA_HOST=your-wordpress-domain

# Protocolo del servidor de medios: "http" (desarrollo) o "https" (producción).
WORDPRESS_MEDIA_PROTOCOL=https

# ─── Modo de contenido ────────────────────────────────────────────────────────
# "mock"  → usa datos estáticos de desarrollo (por defecto)
# "acf"   → conecta a WordPress real vía REST + ACF
CONTENT_SOURCE_MODE=mock

# ─── Preview / Draft Mode ─────────────────────────────────────────────────────
# Secreto para activar el modo de vista previa de borradores de WordPress.
# Genera un valor seguro con: openssl rand -hex 32
PREVIEW_SECRET=replace-with-output-of-openssl-rand-hex-32

# ─── Revalidación on-demand ───────────────────────────────────────────────────
# Secreto para el endpoint de revalidación por webhook de WordPress.
# Debe ser distinto a PREVIEW_SECRET.
# Genera un valor seguro con: openssl rand -hex 32
REVALIDATE_SECRET=replace-with-output-of-openssl-rand-hex-32

# ─── URL pública del sitio ────────────────────────────────────────────────────
# URL raíz del frontend (sin barra final). Usada en sitemap.xml y robots.txt.
# Esta sí puede ser NEXT_PUBLIC_ porque es la URL del sitio visible, no la de la API privada.
NEXT_PUBLIC_SITE_URL=https://your-public-site-domain
